#version 460
#extension GL_GOOGLE_include_directive: require

#include "utils/pbr.glsl"
#include "include/shaders/types.h"

layout (local_size_x = 16, local_size_y = 16) in;

#ifdef UNPACK_MAIN
layout (set = 0, binding = 0) uniform sampler2D i_equirect;
layout (set = 0, binding = 1) writeonly uniform image2DArray o_cubemap;
#endif

#ifdef CONVOLUTE_MAIN
layout (set = 0, binding = 0) uniform samplerCube i_cubemap;
layout (set = 0, binding = 1) writeonly uniform image2DArray o_convolution;
#endif

#ifdef PREFILTER_MAIN
layout (set = 0, binding = 0) uniform samplerCube i_cubemap;
layout (set = 0, binding = 1) writeonly uniform image2DArray o_prefilter;
#endif

layout (scalar, push_constant) uniform PushConstants
{
    int resolution;
#ifdef CONVOLUTE_MAIN
    int env_resolution;
#endif

#ifdef PREFILTER_MAIN
    int env_resolution;
    float roughness;
#endif
} pc;

const vec3 kFaceForward[6] = vec3[](
    vec3( 1,  0,  0),
    vec3(-1,  0,  0),
    vec3( 0,  1,  0),
    vec3( 0, -1,  0),
    vec3( 0,  0,  1),
    vec3( 0,  0, -1)
);

const vec3 kFaceRight[6] = vec3[](
    vec3( 0,  0, -1),
    vec3( 0,  0,  1),
    vec3( 1,  0,  0),
    vec3( 1,  0,  0),
    vec3( 1,  0,  0),
    vec3(-1,  0,  0)
);

const vec3 kFaceUp[6] = vec3[](
    vec3( 0, -1,  0),
    vec3( 0, -1,  0),
    vec3( 0,  0,  1),
    vec3( 0,  0, -1),
    vec3( 0, -1,  0),
    vec3( 0, -1,  0)
);

vec2 to_ndc(vec2 px, vec2 size)
{
    return ((px + vec2(0.5F)) / size) * 2.0F - 1.0F;
}

vec2 to_equirect(vec3 dir)
{
    return vec2(
        atan(dir.z, dir.x) * (0.5F / kPI) + 0.5F,
        acos(clamp(dir.y, -1.0F, 1.0F)) / kPI
    );
}

#ifdef UNPACK_MAIN
void main()
{
    ivec3 image_size = ivec3(pc.resolution);
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, uvec2(image_size.xy))))
        return;

    uint face = gl_GlobalInvocationID.z;

    vec2 pixel = vec2(gl_GlobalInvocationID.xy);
    vec2 uv = to_ndc(pixel, vec2(image_size.xy));

    vec3 dir = normalize(kFaceForward[face] + uv.x * kFaceRight[face] + uv.y * kFaceUp[face]);
    vec4 color = textureLod(i_equirect, to_equirect(dir), 0.0F);

    // note to self -- this min is not arbitrary, this is to avoid double suns illumination in a scene
    // maybe, it would make sense to pass it as a parameter of some sort, but for now this will do
    imageStore(o_cubemap, ivec3(gl_GlobalInvocationID.xyz), min(color, vec4(10.0F)));
}
#endif

#ifdef CONVOLUTE_MAIN1
void main()
{
    ivec3 image_size = ivec3(pc.resolution);
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, uvec2(image_size.xy))))
        return;

    uint face = gl_GlobalInvocationID.z;

    vec2 pixel = vec2(gl_GlobalInvocationID.xy);
    vec2 uv = to_ndc(pixel, vec2(image_size.xy));

    vec3 dir   = normalize(kFaceForward[face] + uv.x * kFaceRight[face] + uv.y * kFaceUp[face]);
    vec3 right = normalize(kFaceRight[face] - dir * dot(dir, kFaceRight[face]));
    vec3 up    = cross(dir, right);
    vec3 irradiance = vec3(0.0);

    float sample_delta = 0.025;
    float total_samples = 0.0;
    for(float phi = 0.0; phi < 2.0 * kPI; phi += sample_delta)
    {
        for(float theta = 0.0; theta < 0.5 * kPI; theta += sample_delta)
        {
            // spherical to cartesian (in tangent space)
            vec3 tangent_sample = vec3(sin(theta) * cos(phi),  sin(theta) * sin(phi), cos(theta));
            // tangent space to world
            vec3 vec_sample = tangent_sample.x * right + tangent_sample.y * up + tangent_sample.z * dir;

            irradiance += textureLod(i_cubemap, vec_sample, 0.0F).rgb * cos(theta) * sin(theta);
            total_samples++;
        }
    }

    irradiance = kPI * irradiance * (1.0 / float(total_samples));
    imageStore(o_convolution, ivec3(gl_GlobalInvocationID.xyz), vec4(irradiance, 1.0));
}
#endif

#ifdef CONVOLUTE_MAIN
void main()
{
    ivec3 image_size = ivec3(pc.resolution);
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, uvec2(image_size.xy))))
    return;

    uint face = gl_GlobalInvocationID.z;

    vec2 pixel = vec2(gl_GlobalInvocationID.xy);
    vec2 uv = to_ndc(pixel, vec2(image_size.xy));

    vec3 n = normalize(kFaceForward[face] + uv.x * kFaceRight[face] + uv.y * kFaceUp[face]);

    float sgn = n.z >= 0.0 ? 1.0 : -1.0;
    float a   = -1.0 / (sgn + n.z);
    float c   = n.x * n.y * a;
    vec3 t = vec3(1.0 + sgn * n.x * n.x * a, sgn * c, -sgn * n.x);
    vec3 b = vec3(c, sgn + n.y * n.y * a, -n.y);

    float env_texel = 4.0 * kPI / (6.0 * float(pc.env_resolution) * float(pc.env_resolution));

    vec3 irradiance = vec3(0.0);

    const uint kSampleCount = 256u;
    for (uint i = 0u; i < kSampleCount; ++i)
    {
        vec2 xi = hammersley(i, kSampleCount);

        // Malley's method: cosine-weighted hemisphere, pdf = cos_theta / kPI
        float phi       = 2.0 * kPI * xi.y;
        float cos_theta = sqrt(1.0 - xi.x);
        float sin_theta = sqrt(xi.x);

        vec3 ls = vec3(sin_theta * cos(phi), sin_theta * sin(phi), cos_theta);
        vec3 ws = ls.x * t + ls.y * b + ls.z * n;

        float sample_solid = kPI / (float(kSampleCount) * max(cos_theta, 1e-4));
        float mip = max(0.5 * log2(sample_solid / env_texel), 0.0);

        irradiance += textureLod(i_cubemap, ws, mip).rgb;
    }

    irradiance /= float(kSampleCount);
    imageStore(o_convolution, ivec3(gl_GlobalInvocationID.xyz), vec4(irradiance, 1.0));
}
#endif

#ifdef PREFILTER_MAIN
void main()
{
    ivec3 image_size = ivec3(pc.resolution);
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, uvec2(image_size.xy))))
        return;

    uint face = gl_GlobalInvocationID.z;

    vec2 pixel = vec2(gl_GlobalInvocationID.xy);
    vec2 uv = to_ndc(pixel, vec2(image_size.xy));

    vec3 view  = normalize(kFaceForward[face] + uv.x * kFaceRight[face] + uv.y * kFaceUp[face]);

    float alpha = pc.roughness * pc.roughness;
    float env_texel  = 4.0 * kPI / (6.0 * pc.env_resolution * pc.env_resolution);

    vec3 nrm = view;

    float weight = 0.0;
    vec3 prefilter_result = vec3(0.0);

    const uint kSampleCount = 1024U;
    for(uint i = 0u; i < kSampleCount; ++i)
    {
        vec2 xi = hammersley(i, kSampleCount);
        vec3 hv = importance_sample_ggx(xi, nrm, pc.roughness);
        vec3 lv = normalize(2.0 * dot(view, hv) * hv - view);

        float n_dot_l = max(dot(nrm, lv), 0.0);
        float n_dot_h = max(dot(nrm, hv), 0.0);
        float h_dot_v = max(dot(hv, view), 0.0);

        if(n_dot_l > 0.0)
        {
            weight += n_dot_l;

            float dst   = distribution_townbridge_reitz_ggx(n_dot_h, alpha);
            float pdf = (dst * n_dot_h / (4.0 * h_dot_v)) + 0.0001;

            float env_sample = 1.0 / (float(kSampleCount) * pdf + 0.0001);
            float mip_level = pc.roughness == 0.0 ? 0.0 : 0.5 * log2(env_sample / env_texel);

            prefilter_result += textureLod(i_cubemap, lv, mip_level).rgb * n_dot_l;
        }
    }

    prefilter_result = prefilter_result / max(weight, 1e-4);
    imageStore(o_prefilter, ivec3(gl_GlobalInvocationID.xyz), vec4(prefilter_result, 1.0));
}
#endif
